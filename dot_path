# ~/.path — shared by interactive shells and noninteractive login shells.

# Keep user-installed tools ahead of system packages without duplicating entries.
__aitor_prepend_path() {
    case ":${PATH:-}:" in
        *:"$1":*) ;;
        *) PATH="$1${PATH:+:$PATH}" ;;
    esac
}
__aitor_prepend_path "$HOME/.local/bin"
__aitor_prepend_path "$HOME/bin"
__aitor_prepend_path "$HOME/.pixi/bin"
__aitor_prepend_path "$HOME/.npm-global/bin"
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
__aitor_prepend_path "$BUN_INSTALL/bin"
export PATH
unset -f __aitor_prepend_path

if [ -f "$HOME/.local/bin/env" ]; then
    . "$HOME/.local/bin/env"
fi
